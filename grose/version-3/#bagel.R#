library(functional) # provides Curry 

# type
setClass("bagel_type", slots=list(particle_constructor = "function",
                                  prior = "function",
				  H = "function",
				  particles = "list",
				  t = "integer"))

# constructor
bagel <- function(particle_constructor,prior,H)
{
   return(new("bagel_type", particle_constructor = particle_constructor, prior = prior, H = H, particles = list(),t = 1L))
}

# update
setMethod("update","bagel_type",
          function(object,y)
	  {

             
	     particle <- object@particle_construct(prior,Curry(H,tau=object@t))
	     

	     theorem_2 <- function(t)
	     {
	        prior.t <- object@prior(t)
		if(t == 1) # this is the first particle
		{
     		   # create the particle
		   object@particles$set(t,object@particle_constructor(prior.t$mu,prior.t$sigma))
 		   return()
	        }
		# create a new particle from the first
		# TODO
	     }

             theorem_3 <- function(t)
             {
		for(tau in 1:t)
		{
		   # object@particles$set(tau) <- update(object@particles$get(tau),object@H(t,tau),y)
		   update(object@particles$get(tau),object@H(t,tau),y)
		}
		return()
	     }

	     theorem_2(object@t)
	     # theorem_3(object@t)
	     object@t <- object@t + 1
	     
	     return(object)
	  })
